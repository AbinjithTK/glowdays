# Glowdays - local configuration
#
# Copy to .env and fill in DATABASE_URL. Everything else has a working default
# for local development. Nothing here is read at build time; the API validates
# the whole file at boot and refuses to start on a bad combination.

NODE_ENV=development
PORT=8787

# ---------------------------------------------------------------- database
# Any Postgres 15+ works. A Neon free branch is the quickest start and the
# connection string moves to RDS unchanged later.
DATABASE_URL=postgres://user:password@localhost:5432/glowdays

# ------------------------------------------------------------------ youcam
# fixture: deterministic local responses, spends no API units. Use this for
#          everything except deliberate live testing - a file watcher
#          restarting the server would otherwise burn the free allocation.
# live:    calls the real analyser. Requires YOUCAM_API_KEY.
YOUCAM_MODE=fixture
# A real key was pasted here, commented out, and committed to a public repository.
# Commenting a credential out does not hide it. This file is meant to be shared, so
# it must never hold anything but a placeholder. The exposed key has been revoked.
# YOUCAM_API_KEY=sk-your-key-here
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
YOUCAM_TASK_VERSION=v2.1

# ----------------------------------------------------------------- storage
# local: filesystem, served back through the API behind a signed link.
# s3:    a private bucket with public access blocked.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Presigned read lifetime. These are photographs of faces; keep it short.
SIGNED_URL_TTL_SECONDS=300

# -------------------------------------------------------------------- auth
# dev:     locally minted HS256 tokens via POST /dev/token. Refused when
#          NODE_ENV=production.
# cognito: verifies RS256 against the user pool's published keys.
AUTH_MODE=dev
DEV_AUTH_SECRET=change-this-to-any-16-plus-character-string
# COGNITO_REGION=ap-south-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# -------------------------------------------------------------------- cors
# Comma separated. No wildcard: the API hands out signed links to face photos.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Mounts /dev (token minting, backdating, fixture masks) and relaxes CORS to
# private LAN addresses so the app can be opened on a phone. Defaults to false
# and is refused outright in production.
ENABLE_DEV_ROUTES=true

# ---------------------------- Neon Auth (optional, additive) ----------------
# Real email-and-password accounts, provisioned by Neon beside the Postgres
# compute. Not a secret: it is a public endpoint, and the browser never calls it
# directly - the API forwards credentials server-side, so the request stays
# same-origin.
#
# Set it and /join/sign-up and /join/sign-in appear alongside whatever AUTH_MODE
# is configured. Leave it empty and nothing changes.
# NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
